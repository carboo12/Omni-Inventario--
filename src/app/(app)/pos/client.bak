import { Plus, Minus, Search, X, ShoppingCart, ScanLine, User, User as UserIcon, Send, ListOrdered, Clock, Users, Trash2, CreditCard, FileText, UserPlus, Monitor } from 'lucide-react';
import { useAuth } from '@/hooks/use-auth';
