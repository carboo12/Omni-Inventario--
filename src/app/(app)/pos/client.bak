    () => import('@/components/pos/assign-client-dialog').then((mod) => mod.AssignClientDialog),
    { ssr: false }
);
const HeldBillsDialog = dynamic(
    () => import('@/components/pos/held-bills-dialog').then((mod) => mod.HeldBillsDialog),
    { ssr: false }
);
const PaymentSummaryDialog = dynamic(
    () => import('@/components/pos/payment-summary-dialog').then((mod) => mod.PaymentSummaryDialog),
    { ssr: false }
);
const QuickSwitchModal = dynamic(
    () => import('@/components/auth/quick-switch-modal').then((mod) => mod.QuickSwitchModal),
    { ssr: false }
);
