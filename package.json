{
  "name": "omni-pos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --port 5173",
    "dev:api": "npx tsx --tsconfig tsconfig.server.json server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "npx prisma generate && npx tsx scripts/build-server.mjs",
    "generate": "npm run gen:modules && npm run gen:client && npm run gen:pages",
    "gen:modules": "npx tsx scripts/generate-action-modules.mjs",
    "gen:client": "npx tsx scripts/generate-client-actions.mjs",
    "gen:pages": "npx tsx scripts/generate-pages-registry.mjs",
    "start": "node dist-server/index.mjs",
    "start:web": "vite preview --port 5173",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "db:push": "prisma migrate deploy",
    "db:deploy": "prisma generate && prisma migrate deploy",
    "db:safe": "node scripts/prisma-safe-deploy.mjs",
    "db:fix-tickets": "npx tsx --tsconfig tsconfig.server.json scripts/fix-ticket-numbers.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/query-async-storage-persister": "^5.102.0",
    "@tanstack/react-query": "^5.102.0",
    "@tanstack/react-query-persist-client": "^5.102.0",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/router-vite-plugin": "^1.167.35",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.9.1",
    "hono": "^4.13.3",
    "jose": "^6.1.3",
    "lucide-react": "^0.475.0",
    "nodemailer": "^8.0.5",
    "patch-package": "^8.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^24.0.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
